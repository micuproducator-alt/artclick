{
  "functions": {
    "api/contact.ts": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "artcllick.ro"
        }
      ],
      "destination": "https://www.artcllick.ro/:path*",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
