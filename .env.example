# Brevo (Sendinblue) API Key
# Găsești cheia pe: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Email-ul tău unde primești notificările
OWNER_EMAIL=artclickon@outlook.com

# Email-ul de pe care se trimit mesajele (trebuie verificat în Brevo)
# Settings → Senders & IP → Add a sender
SENDER_EMAIL=noreply@artclick.ro
